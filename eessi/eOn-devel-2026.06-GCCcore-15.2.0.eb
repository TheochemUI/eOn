# A development environment for eOn on EESSI 2026.06: one module that loads
# everything a meson build of an eOn checkout needs. Install it once into an
# EESSI-extend prefix:
#
#   source /cvmfs/software.eessi.io/versions/2026.06/init/bash
#   mkdir -p "${EESSI_USER_INSTALL:-$HOME/eessi}"
#   module load EESSI-extend
#   eb --umask=022 eessi/eOn-devel-2026.06-GCCcore-15.2.0.eb
#
# foss/2026.1 is an external module. This file builds Cap'n Proto 1.4.0 into
# the same prefix. The configure, build and test commands, and the run-path
# list, are in docs/source/install/eessi.md.
#
# quill, inih, nlohmann_json, Highway, rgpot and readcon-core come from the
# wraps in subprojects/, so the build needs network the first time.
easyblock = 'Bundle'

name = 'eOn-devel'
version = '2026.06'

homepage = 'https://eondocs.org'
description = """Build and test dependencies for developing eOn from a source checkout
 on EESSI 2026.06: compilers, Meson, Ninja, CMake, pkg-config, Eigen, Python,
 Rust, Cap'n Proto, and the foss toolchain (OpenMPI, FFTW, OpenBLAS)."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

dependencies = [
    ('Meson', '1.10.2'),
    ('Ninja', '1.13.2'),
    ('CMake', '4.2.1'),
    ('pkgconf', '2.5.1'),
    ('Eigen', '5.0.0'),
    ('Python', '3.14.2'),
    ('Rust', '1.94.1'),
    # Already installed in EESSI 2026.06. Loads OpenMPI, FFTW and OpenBLAS.
    ('foss/2026.1', 'EXTERNAL_MODULE'),
]

# Cap'n Proto is not an EESSI 2026.06 module. Build it into this prefix so
# one `module load eOn-devel` puts capnp-rpc on PKG_CONFIG_PATH.
components = [
    ('CapnProto', '1.4.0', {
        'easyblock': 'ConfigureMake',
        'source_urls': ['https://capnproto.org/'],
        'sources': ['capnproto-c++-1.4.0.tar.gz'],
        'checksums': ['fa02378ad522b318916b9ad928d1372fc9abd43dd1f4f0392e50450f5c87828f'],
        'configopts': '--libdir=%(installdir)s/lib',
    }),
]

modextrapaths = {
    'PKG_CONFIG_PATH': ['lib/pkgconfig'],
}

# Name the compilers: meson otherwise wraps cc in any ccache or sccache on PATH.
modextravars = {
    'CC': 'gcc',
    'CXX': 'g++',
    'FC': 'gfortran',
}

# cargo ignores CURL_CA_BUNDLE, which EESSI's init sets on systems whose CA
# bundle is not at the Debian path; readcon-core's cargo build needs it.
#
# EESSI 2026.06 leaves LD_LIBRARY_PATH unset. The compat libstdc++ is GCC 14
# (up to GLIBCXX_3.4.33). This compiler is GCC 15.2 (GLIBCXX_3.4.34). The
# footer puts software/GCCcore/15.2.0/lib64 on the rpath so the link finds
# that libstdc++.
# A program that needs libfftw3.so.3 and has only that rpath exits 127
# (libfftw3.so.3: cannot open shared object file). Adding
# software/FFTW/3.3.10-GCC-15.2.0/lib to RUNPATH makes the same program
# exit 0 and print "fftw fftw-3.3.10-sse2-avx-avx2-avx2_128". Each further
# module library needs its own -Wl,-rpath.
# buildenv/default-foss-2026.1 ships in this release. It depends on
# foss/2026.1, adds rpath_wrappers entries for gcc, g++, gfortran, ld and
# ld.bfd to PATH, and pushenv's LDFLAGS to -L directories (ScaLAPACK,
# FFTW, FlexiBLAS, OpenMPI, GCCcore). The setenv below replaces that
# LDFLAGS. The exit codes above are from -Wl,-rpath on the link line.
modluafooter = """
local ca = os.getenv("CURL_CA_BUNDLE")
if ca and ca ~= "" then
    setenv("CARGO_HTTP_CAINFO", ca)
end
local sw = os.getenv("EESSI_SOFTWARE_PATH")
if sw and sw ~= "" then
    setenv("LDFLAGS", "-Wl,-rpath," .. pathJoin(sw, "software/GCCcore/%(toolchain_version)s/lib64"))
end
"""

moduleclass = 'devel'
