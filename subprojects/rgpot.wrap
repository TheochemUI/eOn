[wrap-git]
directory = rgpot
url = https://github.com/OmniPotentRPC/rgpot.git
# EMT, calculator-group MPI, and the readcon interface are supplied by
# the same rgpot revision for every eOn potential factory arm.
# The revision is rgpot 3.5.1 or newer (librgpot.so.4).
# rgpot develop 9e1abb3cd3eeb5cd276c3ad20a809d46fc395ec6 stores the EON
# r2549 eam_al parameters at single precision. That tree has diverged
# from this pin: it has no EMT, no calculator groups, and soversion 3.
# rgpot-eam-al-r2549-literals.patch applies those literals here.
revision = e40fd175f5230098d56333bf2aff38cd839dc810
depth = 1
diff_files = rgpot-capnp-includes.patch, rgpot-lj-fp-contract.patch, rgpot-windows-link-whole.patch, rgpot-windows-flang-rt.patch, rgpot-eam-al-r2549-literals.patch
