# Copy to .env; paths can use $HOME. This file is sourced by Bash.
EON_CLIENT=eonclient
CPMD_BIN=$HOME/myCPMD/bin/cpmd4.3-oneAPI-2022-AMD.x
PP_LIBRARY_PATH=$HOME/pseudo
CPMD_PP='14:Si_MT_BLYP.psp:LMAX=D LOC=D,7:N_MT_BLYP.psp:LMAX=P LOC=P'
CPMD_MPI_LAUNCH='mpirun -np 4'
# Leave empty for a CPMD executable built with the current MPI environment.
CPMD_MODULES='intel/oneAPI-2022 intelmpi/oneAPI-2022'
CPMD_FUNCTIONAL=BLYP
CPMD_CUTOFF=70
CPMD_CONVERGENCE=1e-6
# For a multi-species system list every species, e.g.:
# CPMD_PP='14:Si_MT_BLYP.psp:LMAX=P,7:N_MT_BLYP.psp:LMAX=P'
# XYZ coordinates: angstrom or bohr. Frame numbering starts at zero; -1 is last.
XYZ_UNITS=angstrom
XYZ_FRAME=-1
# CON inputs use Angstrom and retain their cell; select the first frame by default.
CON_FRAME=0
# Empty: use extended-XYZ Lattice metadata, otherwise infer with a loud warning.
# Set three lengths in Angstrom, e.g. CELL_ANGSTROM='9.984 19.968 14.976'.
CELL_ANGSTROM=''
CELL_ANGLES='90 90 90'
VACUUM_ANGSTROM=10
