{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eondocs.org/schema/ams.json",
  "title": "AMS",
  "description": "config.ini [AMS] section (AMSConfig). Keys, defaults, and allowed values.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "engine": {
      "default": "",
      "description": "Engine for AMS calculation. One of REAXFF, MOPAC.",
      "enum": [
        "",
        "REAXFF",
        "MOPAC"
      ],
      "type": "string"
    },
    "forcefield": {
      "default": "",
      "description": "Force field to use (e.g., 'OPt.ff').",
      "type": "string"
    },
    "model": {
      "default": "",
      "description": "Model to use (e.g., 'PM7', 'PM3').",
      "type": "string"
    },
    "xc": {
      "default": "",
      "description": "Exchange-correlation functional.",
      "type": "string"
    },
    "basis": {
      "default": "",
      "description": "Basis set to use with the exchange-correlation functional.",
      "type": "string"
    },
    "resources": {
      "default": "",
      "description": "Resources path for DFTB.",
      "type": "string"
    }
  }
}
